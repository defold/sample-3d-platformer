local game_context = require("game.context")
local messages = require("game.messages")
local groups = require("game.groups")

go.property("coins", 0)

local GRAVITY = -25.0
local MAX_FALL_SPEED = -30.0
local MOVEMENT_SPEED = 5.0
local GROUND_MOVEMENT_RESPONSE = 14.0
local AIR_MOVEMENT_RESPONSE = 5.0
local FACING_SMOOTH_SPEED = 12.0
local JUMP_SPEED = 8.0
local JUMP_RELEASE_MULTIPLIER = 0.5
local JUMP_BUFFER_TIME = 0.12
local COYOTE_TIME = 0.12
local GROUND_NORMAL_Y = 0.6
local GROUND_PROBE_START_OFFSET = vmath.vector3(0.0, 0.08, 0.0)
local GROUND_PROBE_END_OFFSET = vmath.vector3(0.0, -0.16, 0.0)
local GROUND_PROBE_GROUPS = { groups.PLATFORM }
local LAND_SOUND_SPEED = -10.0
local FALL_RESPAWN_Y = -14
local DUST_GROUND_COUNT = 4
local DUST_JUMP_COUNT = 3
local DUST_DOUBLE_JUMP_COUNT = 3
local DUST_LIFETIME = 0.42
local WALK_DUST_INTERVAL = 0.16
local WALK_DUST_SPEED_SQR = 0.25
local TAU = math.pi * 2.0

local VISUAL_SCALE = vmath.vector3(1.0, 1.0, 1.0)
local JUMP_SCALE = vmath.vector3(0.92, 1.1, 0.92)
local DOUBLE_JUMP_SCALE = vmath.vector3(1.1, 0.84, 1.1)
local LAND_SCALE = vmath.vector3(1.13, 0.82, 1.13)

local ANIMATION_STATE_IDLE = 1
local ANIMATION_STATE_WALK = 2
local ANIMATION_STATE_JUMP = 3
local ANIMATION_STATE_DOUBLE_JUMP = 4
local ANIMATION_STATE_FALL = 5
local ANIMATION_MOVE_SPEED_SQR = 0.01
local ANIMATION_BLEND_DURATION = 0.1

local ANIMATIONS = {
	[ANIMATION_STATE_IDLE] = { id = "idle", playback = go.PLAYBACK_LOOP_FORWARD },
	[ANIMATION_STATE_WALK] = { id = "walk", playback = go.PLAYBACK_LOOP_FORWARD },
	[ANIMATION_STATE_JUMP] = { id = "jump", playback = go.PLAYBACK_ONCE_FORWARD },
	[ANIMATION_STATE_DOUBLE_JUMP] = { id = "jump", playback = go.PLAYBACK_ONCE_FORWARD },
	[ANIMATION_STATE_FALL] = { id = "fall", playback = go.PLAYBACK_LOOP_FORWARD },
}

local ACTION_LEFT = hash("move_left")
local ACTION_RIGHT = hash("move_right")
local ACTION_FORWARD = hash("move_forward")
local ACTION_BACK = hash("move_back")
local ACTION_JUMP = hash("jump")
local ACTION_GAMEPAD_DISCONNECTED = hash("gamepad_disconnected")

local PLAYER_FORWARD = vmath.vector3(0, 0, 1)
local MOVEMENT_INPUTS = {
	[ACTION_LEFT] = "move_left",
	[ACTION_RIGHT] = "move_right",
	[ACTION_FORWARD] = "move_forward",
	[ACTION_BACK] = "move_back",
}

---@class PlayerState
---@field coins number Collected coins used by the local win condition.
---@field velocity vector3 Simulation velocity in world space.
---@field correction vector3 Penetration already resolved during message dispatch.
---@field grounded boolean
---@field has_ground_contact boolean
---@field coyote_timer number
---@field jump_buffer_timer number
---@field jumps_used number
---@field facing_yaw number
---@field visual_id hash|nil Separate interpolated presentation object.
---@field visual_model_url url|nil Model component on the current visual object.
---@field visual_variant number|nil Locally instantiated character factory index.
---@field animation_state number|nil
---@field original_position vector3
---@field walk_dust_timer number
---@field move_left number
---@field move_right number
---@field move_forward number
---@field move_back number

---@param self PlayerState
---@param next_state number
local function transition_animation(self, next_state)
	if self.animation_state == next_state then
		return
	end

	local animation = ANIMATIONS[next_state]
	local blend_duration = self.animation_state and ANIMATION_BLEND_DURATION or 0.0
	self.animation_state = next_state
	model.play_anim(self.visual_model_url, animation.id, animation.playback, {
		blend_duration = blend_duration,
	})
end

---Creates the model separately from the physics root and makes it the
---object-interpolation target.
---@param self PlayerState
---@param variant_index number
local function create_visual(self, variant_index)
	if self.visual_id then
		go.delete(self.visual_id)
	end

	self.visual_variant = variant_index
	self.visual_id = factory.create(game_context.player_visual_factories[variant_index], go.get_position(), go.get_rotation())
	self.visual_model_url = msg.url(nil, self.visual_id, "model")
	msg.post("#objectinterpolation", "set_apply_transform", {
		apply_transform = object_interpolation.APPLY_TRANSFORM_TARGET,
		target_object = self.visual_id,
	})
	local animation_state = self.animation_state or ANIMATION_STATE_IDLE
	self.animation_state = nil
	transition_animation(self, animation_state)
end

---@param from number
---@param to number
---@param t number
---@return number
local function lerp_angle(from, to, t)
	local delta = to - from
	delta = (delta + math.pi) % TAU - math.pi
	return from + delta * t
end

---@param action table
---@param current_value number
---@return number
local function update_input_strength(action, current_value)
	if action.released then
		return 0.0
	end
	if action.value then
		return math.abs(action.value)
	end
	if action.pressed then
		return 1.0
	end
	return current_value
end

---@param self PlayerState
local function reset_movement_input(self)
	self.move_left = 0.0
	self.move_right = 0.0
	self.move_forward = 0.0
	self.move_back = 0.0
end

---Builds normalized camera-relative movement in world space.
---@param self PlayerState
---@return vector3
local function get_movement_input(self)
	local movement = vmath.vector3(
		self.move_right - self.move_left,
		0.0,
		self.move_back - self.move_forward
	)
	if vmath.length_sqr(movement) > 1.0 then
		movement = vmath.normalize(movement)
	end

	local camera_rotation = go.get_rotation(game_context.camera.path)
	return vmath.rotate(camera_rotation, movement)
end

---@param self PlayerState
---@return number
local function get_animation_state(self)
	if not self.grounded then
		if self.velocity.y > 0.0 then
			return self.jumps_used >= 2 and ANIMATION_STATE_DOUBLE_JUMP or ANIMATION_STATE_JUMP
		end
		return ANIMATION_STATE_FALL
	end

	local horizontal_speed_sqr = self.velocity.x * self.velocity.x + self.velocity.z * self.velocity.z
	return horizontal_speed_sqr > ANIMATION_MOVE_SPEED_SQR and ANIMATION_STATE_WALK or ANIMATION_STATE_IDLE
end

---Keeps an established grounded state across the gap between a fixed update
---and the contact messages generated from that simulation step.
---@param self PlayerState
---@return boolean
local function has_ground_probe_support(self)
	if self.velocity.y > 0.0 then
		return false
	end

	local position = go.get_position()
	local hit = physics.raycast(
		position + GROUND_PROBE_START_OFFSET,
		position + GROUND_PROBE_END_OFFSET,
		GROUND_PROBE_GROUPS
	)
	return hit ~= nil and hit.normal.y >= GROUND_NORMAL_Y
end

---@param self PlayerState
local function update_animation_state(self)
	local next_state = get_animation_state(self)
	transition_animation(self, next_state)
end

local function play_jump_sound()
	msg.post(game_context.sounds, messages.SOUND_JUMP)
end

local function play_land_sound()
	msg.post(game_context.sounds, messages.SOUND_LAND)
end

---@param self PlayerState
---@param target_scale vector3
---@param squeeze_duration number
---@param recover_duration number
local function animate_visual_scale(self, target_scale, squeeze_duration, recover_duration)
	go.cancel_animations(self.visual_id, "scale")
	go.animate(self.visual_id, "scale", go.PLAYBACK_ONCE_FORWARD, target_scale, go.EASING_OUTQUAD,
		squeeze_duration, 0.0, function(callback_self, url, property)
			go.animate(callback_self.visual_id, "scale", go.PLAYBACK_ONCE_FORWARD, VISUAL_SCALE,
				go.EASING_OUTBACK, recover_duration)
		end)
end

---@param self PlayerState
---@param origin vector3
---@param count number
---@param airborne boolean
local function spawn_dust(self, origin, count, airborne)
	local phase = math.random() * TAU
	for index = 1, count do
		local angle = phase + (index - 1) * TAU / count
		local outward_speed = 0.3 + math.random() * 0.25
		local upward_speed = airborne and (-0.04 + math.random() * 0.08) or (0.06 + math.random() * 0.12)
		local travel = vmath.vector3(
			math.cos(angle) * outward_speed,
			upward_speed,
			math.sin(angle) * outward_speed
		)
		local size = 0.2 + math.random() * 0.1
		local peak = 0.56 + math.random() * 0.24
		factory.create("#dust_factory", origin, vmath.quat_rotation_y(angle), {
			travel = travel,
			lifetime = DUST_LIFETIME + math.random() * 0.08,
			peak_scale = vmath.vector3(peak, peak * 0.72, peak),
		}, vmath.vector3(size, size, size))
	end
end

---@param self PlayerState
---@param dt number
---@param is_walking boolean
local function update_walking_dust(self, dt, is_walking)
	if not is_walking then
		self.walk_dust_timer = 0.0
		return
	end

	self.walk_dust_timer = self.walk_dust_timer - dt
	if self.walk_dust_timer <= 0.0 then
		spawn_dust(self, go.get_position(), 1, false)
		self.walk_dust_timer = WALK_DUST_INTERVAL
	end
end

---@param self PlayerState
---@param is_double_jump boolean
local function play_jump_effects(self, is_double_jump)
	if is_double_jump then
		spawn_dust(self, go.get_position() + vmath.vector3(0.0, 0.1, 0.0), DUST_DOUBLE_JUMP_COUNT, true)
		animate_visual_scale(self, DOUBLE_JUMP_SCALE, 0.06, 0.16)
	else
		spawn_dust(self, go.get_position(), DUST_JUMP_COUNT, false)
		animate_visual_scale(self, JUMP_SCALE, 0.06, 0.14)
	end
end

---@param self PlayerState
local function play_land_effects(self)
	spawn_dust(self, go.get_position(), DUST_GROUND_COUNT, false)
	animate_visual_scale(self, LAND_SCALE, 0.055, 0.18)
end

---@param self PlayerState
---@param jumps_used number
local function perform_jump(self, jumps_used)
	self.jumps_used = jumps_used
	self.jump_buffer_timer = 0.0
	self.coyote_timer = 0.0
	self.velocity.y = JUMP_SPEED
	self.grounded = false
	self.has_ground_contact = false
	local is_double_jump = jumps_used >= 2
	local next_state = is_double_jump and ANIMATION_STATE_DOUBLE_JUMP or ANIMATION_STATE_JUMP
	transition_animation(self, next_state)
	play_jump_effects(self, is_double_jump)
	play_jump_sound()
end

---@param self PlayerState
local function try_jump(self)
	if self.jump_buffer_timer <= 0.0 then
		return
	end

	if self.jumps_used == 0 and (self.grounded or self.coyote_timer > 0.0) then
		perform_jump(self, 1)
	elseif not self.grounded and self.jumps_used < 2 then
		perform_jump(self, 2)
	end
end

---@param self PlayerState
---@param movement_input vector3
---@param dt number
local function update_horizontal_velocity(self, movement_input, dt)
	local response = self.grounded and GROUND_MOVEMENT_RESPONSE or AIR_MOVEMENT_RESPONSE
	local blend = 1.0 - math.exp(-response * dt)
	local target_x = movement_input.x * MOVEMENT_SPEED
	local target_z = movement_input.z * MOVEMENT_SPEED
	self.velocity.x = self.velocity.x + (target_x - self.velocity.x) * blend
	self.velocity.z = self.velocity.z + (target_z - self.velocity.z) * blend
end

---@param self PlayerState
local function reset_motion(self)
	self.velocity = vmath.vector3()
	self.correction = vmath.vector3()
	self.grounded = false
	self.has_ground_contact = false
	self.coyote_timer = 0.0
	self.jump_buffer_timer = 0.0
	self.jumps_used = 0
	self.walk_dust_timer = 0.0
end

---Assigns input, camera, and shadow tracking to the player.
---@param self PlayerState
local function activate_local_player(self)
	msg.post(".", "acquire_input_focus")
	game_context.local_player = go.get_id()
	msg.post(game_context.camera, "follow", { url = self.visual_id })
	msg.post(game_context.shadows, messages.FOLLOW_SHADOW_TARGET, { target = self.visual_id })
end

---Teleports both simulation and interpolation history to the spawn point.
---@param self PlayerState
local function respawn(self)
	reset_motion(self)
	self.animation_state = nil
	transition_animation(self, ANIMATION_STATE_FALL)
	go.cancel_animations(self.visual_id, "scale")
	go.set_scale(VISUAL_SCALE, self.visual_id)
	go.set_position(self.original_position)
	go.set("#objectinterpolation", "position", self.original_position)
end

---@param self PlayerState
local function reset_player(self)
	respawn(self)
	self.coins = 0
	msg.post(game_context.ui, messages.UPDATE_COIN_UI, { amount = 0 })
end

-------------------------------
-- Defold lifecycle functions:
-------------------------------

function init(self)
	reset_movement_input(self)
	reset_motion(self)

	local player_forward = vmath.rotate(go.get_rotation(), PLAYER_FORWARD)
	self.facing_yaw = math.atan2(player_forward.x, player_forward.z)
	self.animation_state = nil
	self.original_position = go.get_position()
	create_visual(self, 1)
	activate_local_player(self)
end

function final(self)
	go.delete(self.visual_id)
end

function fixed_update(self, dt)
	self.correction = vmath.vector3()
	-- Physics contacts describe the preceding simulation step. The short probe
	-- preserves an established ground state when shapes are exactly touching.
	self.grounded = self.has_ground_contact or (self.grounded and has_ground_probe_support(self))
	self.has_ground_contact = false
	if self.grounded then
		self.coyote_timer = COYOTE_TIME
	else
		self.coyote_timer = math.max(0.0, self.coyote_timer - dt)
	end
	self.jump_buffer_timer = math.max(0.0, self.jump_buffer_timer - dt)

	try_jump(self)

	local movement_input = get_movement_input(self)
	update_horizontal_velocity(self, movement_input, dt)

	if vmath.length_sqr(movement_input) > 0.001 then
		local target_yaw = math.atan2(movement_input.x, movement_input.z)
		local rotation_alpha = 1.0 - math.exp(-FACING_SMOOTH_SPEED * dt)
		self.facing_yaw = lerp_angle(self.facing_yaw, target_yaw, rotation_alpha)
		go.set_rotation(vmath.quat_rotation_y(self.facing_yaw))
	end

	if self.grounded and self.velocity.y <= 0.0 then
		self.velocity.y = 0.0
	else
		self.velocity.y = math.max(MAX_FALL_SPEED, self.velocity.y + GRAVITY * dt)
	end
	update_animation_state(self)
	local horizontal_speed_sqr = self.velocity.x * self.velocity.x + self.velocity.z * self.velocity.z
	update_walking_dust(self, dt, self.grounded and horizontal_speed_sqr > WALK_DUST_SPEED_SQR)

	-- Physics moves the root; interpolation updates the separate visual.
	local pos = go.get_position()
	pos = pos + self.velocity * dt

	if pos.y < FALL_RESPAWN_Y then
		respawn(self)
		return
	end

	go.set_position(pos)
end

function on_message(self, message_id, message, sender)
	if message_id == messages.CONTACT_POINT_RESPONSE then
		if message.other_group == groups.PLATFORM then
			if message.distance > 0 then
				-- Contact messages may overlap at corners. Project the correction
				-- already applied onto this normal so each contact contributes only
				-- its unresolved penetration instead of pushing the player twice.
				local proj = vmath.project(self.correction, message.normal * message.distance)
				if proj < 1 then
					local comp = (message.distance - message.distance * proj) * message.normal
					go.set_position(go.get_position() + comp)
					self.correction = self.correction + comp
				end
			end

			if message.normal.y >= GROUND_NORMAL_Y and self.velocity.y <= 0.0 then
				local landed = not self.grounded
				local impact_speed = self.velocity.y
				self.velocity.y = 0.0
				self.grounded = true
				self.has_ground_contact = true
				self.jumps_used = 0
				if landed then
					if impact_speed <= LAND_SOUND_SPEED then
						play_land_sound()
					end
					play_land_effects(self)
				end
			end
		end
	elseif message_id == messages.COIN_COLLECTED then
		self.coins = self.coins + 1
		msg.post(game_context.ui, messages.UPDATE_COIN_UI, { amount = self.coins })
		msg.post(game_context.sounds, messages.SOUND_COIN_COLLECTED)
	elseif message_id == messages.RESET_PLAYER then
		reset_player(self)
	end
end

function on_input(self, action_id, action)
	local movement_input = MOVEMENT_INPUTS[action_id]
	if movement_input then
		self[movement_input] = update_input_strength(action, self[movement_input])
	elseif action_id == ACTION_JUMP then
		if action.pressed then
			self.jump_buffer_timer = JUMP_BUFFER_TIME
		elseif action.released and self.velocity.y > 0.0 then
			self.velocity.y = self.velocity.y * JUMP_RELEASE_MULTIPLIER
		end
	elseif action_id == ACTION_GAMEPAD_DISCONNECTED then
		reset_movement_input(self)
	end
end
