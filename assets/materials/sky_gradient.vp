#version 140

in highp vec4 position;

out mediump float var_screen_height;

uniform vs_uniforms
{
	highp mat4 mtx_view;
	highp mat4 mtx_proj;
};

void main()
{
	mat4 view_rotation = mtx_view;
	view_rotation[3].xyz = vec3(0.0);
	vec4 clip_position = mtx_proj * view_rotation * vec4(position.xyz, 1.0);
	var_screen_height = clip_position.y / clip_position.w;
	gl_Position = clip_position.xyww;
}
